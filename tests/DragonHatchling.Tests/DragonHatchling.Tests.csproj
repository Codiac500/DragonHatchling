<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <UseWPF Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Include="../../src/DragonHatchling.Desktop/PetState.cs" Link="PetState.cs" />
    <Compile Include="../../src/DragonHatchling.Desktop/PetController.cs" Link="PetController.cs" />
    <Compile Include="../../src/DragonHatchling.Desktop/SaveStore.cs" Link="SaveStore.cs" />
    <Compile Include="../../src/DragonHatchling.Desktop/Placement.cs" Link="Placement.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="../../src/DragonHatchling.Desktop/DragonHatchling.Desktop.csproj" />
  </ItemGroup>
</Project>
