<Window x:Class="DragonHatchling.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DragonHatchling" Width="240" Height="280"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="True" Topmost="False"
        PreviewKeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="176" />
            <RowDefinition Height="104" />
        </Grid.RowDefinitions>
        <!-- A compact rectangular drag target; no promise of per-pixel hit testing. -->
        <Border Width="192" Height="172" Background="Transparent" Cursor="SizeAll"
                MouseLeftButtonDown="Placeholder_MouseLeftButtonDown"
                ToolTip="Drag visible egg or dragon to move" AutomationProperties.Name="Drag pet to move">
            <Image x:Name="PetImage" Width="160" Height="160"
                   Stretch="Uniform" IsHitTestVisible="False" />
        </Border>
        <Border Grid.Row="1" Margin="8,0,8,4" Background="#F2222835"
                CornerRadius="10" Padding="8,6">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Egg · Ready to hatch" Foreground="#C4CEDF"
                           FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,4" MaxWidth="204" TextTrimming="CharacterEllipsis" />
                <UniformGrid Columns="3" Margin="0,0,0,5">
                    <Button x:Name="HatchButton" Content="Hatch" Click="Hatch_Click" Padding="4,2" Margin="0,0,3,0" />
                    <Button x:Name="FeedButton" Content="Feed" Click="Feed_Click" IsEnabled="False" Padding="4,2" Margin="0,0,3,0" />
                    <Button x:Name="PlayButton" Content="Play" Click="Play_Click" IsEnabled="False" Padding="4,2" />
                </UniformGrid>
                <CheckBox x:Name="TopmostToggle" Content="Always on top" Foreground="White"
                          Checked="Topmost_Changed" Unchecked="Topmost_Changed"
                          Margin="2,0,0,5" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Reset position" Click="Reset_Click" Padding="8,2"
                            ToolTip="Center on primary display (Ctrl+Home)" Margin="0,0,8,0" />
                    <Button Content="Exit" Click="Exit_Click" Padding="12,2" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
